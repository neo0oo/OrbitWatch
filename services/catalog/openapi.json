{
  "openapi": "3.1.0",
  "info": {
    "title": "OrbitWatch catalog",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/satellites": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Get Satellites",
        "operationId": "get_satellites_api_satellites_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Satellite"
                  },
                  "type": "array",
                  "title": "Response Get Satellites Api Satellites Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "catalog"
        ],
        "summary": "Post Satellite",
        "operationId": "post_satellite_api_satellites_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SatelliteIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddedSatellite"
                }
              }
            }
          },
          "404": {
            "description": "No TLE on Celestrak"
          },
          "502": {
            "description": "Celestrak unreachable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/satellites/{norad_id}": {
      "delete": {
        "tags": [
          "catalog"
        ],
        "summary": "Delete Satellite",
        "operationId": "delete_satellite_api_satellites__norad_id__delete",
        "parameters": [
          {
            "name": "norad_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Norad Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Not in the catalog"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/satellites/{norad_id}/tle": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Get Satellite Tle",
        "operationId": "get_satellite_tle_api_satellites__norad_id__tle_get",
        "parameters": [
          {
            "name": "norad_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Norad Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tle"
                }
              }
            }
          },
          "404": {
            "description": "Not in the catalog"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddedSatellite": {
        "properties": {
          "norad_id": {
            "type": "integer",
            "title": "Norad Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "norad_id",
          "name"
        ],
        "title": "AddedSatellite"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "db": {
            "type": "string",
            "title": "Db"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "db",
          "version"
        ],
        "title": "Health"
      },
      "Satellite": {
        "properties": {
          "norad_id": {
            "type": "integer",
            "title": "Norad Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "operator": {
            "type": "string",
            "title": "Operator"
          },
          "added_at": {
            "type": "string",
            "format": "date-time",
            "title": "Added At"
          }
        },
        "type": "object",
        "required": [
          "norad_id",
          "name",
          "category",
          "operator",
          "added_at"
        ],
        "title": "Satellite"
      },
      "SatelliteIn": {
        "properties": {
          "norad_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Norad Id"
          }
        },
        "type": "object",
        "required": [
          "norad_id"
        ],
        "title": "SatelliteIn"
      },
      "Tle": {
        "properties": {
          "norad_id": {
            "type": "integer",
            "title": "Norad Id"
          },
          "line1": {
            "type": "string",
            "title": "Line1"
          },
          "line2": {
            "type": "string",
            "title": "Line2"
          }
        },
        "type": "object",
        "required": [
          "norad_id",
          "line1",
          "line2"
        ],
        "title": "Tle"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
