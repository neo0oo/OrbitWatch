{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrbitWatch system description",
  "description": "Describes every service, its configuration, its calls across the seam and its Azure resources.",
  "type": "object",
  "required": ["student", "prefix", "public_url", "ui", "azure", "services"],
  "additionalProperties": false,
  "properties": {
    "student": { "type": "string", "minLength": 1, "description": "IE username" },
    "prefix": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Prefix of every Azure resource" },
    "public_url": { "type": "string", "pattern": "^https://", "description": "Public URL of the Static Web App" },
    "ui": {
      "type": "object",
      "required": ["path", "static_web_app", "calls"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "static_web_app": { "type": "string" },
        "calls": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "azure": {
      "type": "object",
      "required": ["resource_group", "container_apps_environment", "sql_server", "registry"],
      "additionalProperties": false,
      "properties": {
        "resource_group": { "type": "string" },
        "container_apps_environment": { "type": "string" },
        "sql_server": { "type": "string" },
        "registry": { "type": "string" }
      }
    },
    "services": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": { "$ref": "#/$defs/service" }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "required": ["description", "path", "openapi", "port_default", "health", "migrations", "env", "calls", "azure"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "path": { "type": "string" },
        "openapi": { "type": "string" },
        "port_default": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "health": { "type": "string", "pattern": "^/" },
        "migrations": { "type": "string" },
        "env": {
          "type": "object",
          "required": ["PORT", "DATABASE_URL"],
          "additionalProperties": { "$ref": "#/$defs/envVar" }
        },
        "calls": { "type": "array", "items": { "$ref": "#/$defs/call" } },
        "azure": {
          "type": "object",
          "required": ["container_app", "sql_database"],
          "additionalProperties": false,
          "properties": {
            "container_app": { "type": "string" },
            "sql_database": { "type": "string" }
          }
        }
      }
    },
    "envVar": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "default": { "type": ["string", "number", "boolean"] },
        "secret": { "type": "boolean" },
        "description": { "type": "string" }
      },
      "if": { "required": ["secret"], "properties": { "secret": { "const": true } } },
      "then": { "not": { "required": ["default"] } },
      "else": { "required": ["default"] }
    },
    "call": {
      "type": "object",
      "required": ["service", "url_env", "endpoints", "timeout_s", "on_failure"],
      "additionalProperties": false,
      "properties": {
        "service": { "type": "string" },
        "url_env": { "type": "string" },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(GET|POST|PUT|PATCH|DELETE) /" }
        },
        "timeout_s": { "type": "number", "exclusiveMinimum": 0 },
        "on_failure": { "type": "string" }
      }
    }
  }
}
